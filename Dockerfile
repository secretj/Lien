# ==============================================================================
# Multi-Stage Docker Build for Spring Boot Application
# ==============================================================================
# 이 Dockerfile은 멀티 스테이지 빌드를 사용하여 최적화된 이미지를 생성합니다.
#
# 이점:
# 1. 이미지 크기 최소화 (빌드 도구 제외)
#    - 빌드 스테이지: ~1GB (Gradle + JDK 21 포함)
#    - 런타임 스테이지: ~200MB (JRE + JAR만 포함)
#
# 2. 보안 강화
#    - non-root 사용자로 실행
#    - 최소한의 런타임 의존성
#
# 3. 빌드 캐싱 최적화
#    - 의존성 변경 시에만 재다운로드
#    - 소스 코드 변경은 빠르게 반영
# ==============================================================================


# ==============================================================================
# Stage 1: Build Stage
# ==============================================================================
# 역할: 소스 코드를 컴파일하고 실행 가능한 JAR 파일 생성
#
# gradle:8.5-jdk21 이미지 선택 이유:
# - Gradle 빌드 도구 포함
# - JDK 21 (컴파일에 필요)
# - 공식 Gradle 이미지로 안정성 보장
# ==============================================================================
FROM gradle:8.5-jdk21 AS build

# 작업 디렉토리 설정
WORKDIR /app

# 의존성 파일 먼저 복사 (캐싱 최적화)
# 이점: build.gradle이 변경되지 않으면 의존성 다운로드 단계 캐싱
#
# 예시:
# 1차 빌드: 의존성 다운로드 (5분 소요)
# 2차 빌드 (소스 코드만 변경): 캐시 사용 (10초 소요)
COPY build.gradle settings.gradle ./
COPY gradle ./gradle

# 소스 코드 복사
# 참고: 위에서 의존성 파일을 먼저 복사했으므로, 
#       소스 코드 변경 시 의존성 다운로드 단계는 캐싱됨
COPY src ./src

# Gradle 빌드 실행
# -x test: 테스트 건너뛰기 (CI/CD에서 별도 실행)
# --no-daemon: Gradle 데몬 비활성화 (컨테이너 환경에서 불필요)
#
# 결과: /app/build/libs/*.jar 파일 생성
#
# 예시:
# lien-0.0.1-SNAPSHOT.jar (약 50MB)
RUN gradle build -x test --no-daemon


# ==============================================================================
# Stage 2: Runtime Stage
# ==============================================================================
# 역할: 최소화된 런타임 환경에서 애플리케이션 실행
#
# eclipse-temurin:21-jre-alpine 선택 이유:
# 1. JRE만 포함 (JDK 불필요, 이미지 크기 감소)
# 2. Alpine Linux 기반 (최소 크기, 보안 패치 빠름)
# 3. Eclipse Temurin (OpenJDK 공식 빌드, 안정성)
#
# 크기 비교:
# - openjdk:21 (JDK): ~600MB
# - eclipse-temurin:21-jre: ~300MB
# - eclipse-temurin:21-jre-alpine: ~200MB ✓
# ==============================================================================
FROM eclipse-temurin:21-jre-alpine

# 작업 디렉토리 설정
WORKDIR /app

# ==============================================================================
# 보안: Non-Root 사용자 생성 및 전환
# ==============================================================================
# 역할: root 권한으로 실행하지 않아 보안 취약점 최소화
#
# 이점:
# 1. 컨테이너 탈출 공격 시 피해 최소화
# 2. Kubernetes SecurityContext 호환
# 3. 보안 스캔 통과 (root 실행 경고 제거)
#
# 명령어 설명:
# - addgroup -S spring: spring 그룹 생성 (시스템 그룹)
# - adduser -S spring -G spring: spring 사용자 생성 및 그룹 할당
# - USER spring:spring: 이후 명령을 spring 사용자로 실행
#
# 예시:
# # 컨테이너 접속 시
# $ whoami
# spring  (root가 아님)
# ==============================================================================
RUN addgroup -S spring && adduser -S spring -G spring
USER spring:spring

# 빌드 스테이지에서 생성된 JAR 파일 복사
# --from=build: 첫 번째 스테이지(build)에서 파일 가져오기
# *.jar: 버전 관계없이 모든 JAR 파일 복사
#
# 결과 파일 경로: /app/app.jar
COPY --from=build /app/build/libs/*.jar app.jar

# 포트 8080 노출
# 참고: 이것은 문서화 목적이며, 실제 포트 바인딩은 docker run -p 옵션으로 지정
#
# 예시:
# docker run -p 8080:8080 lien-app
# -> 호스트의 8080 포트를 컨테이너의 8080 포트에 연결
EXPOSE 8080

# ==============================================================================
# JVM 최적화 옵션으로 애플리케이션 실행
# ==============================================================================
# 역할: 컨테이너 환경에 최적화된 JVM 설정으로 실행
#
# 옵션 설명:
#
# 1. -XX:+UseContainerSupport
#    이점: 컨테이너의 CPU/메모리 제한 인식
#    예시: Docker에 2GB 메모리 할당 시 JVM도 2GB 제한 인식
#    없으면: 호스트 전체 메모리 기준으로 힙 크기 설정 (OOM 위험)
#
# 2. -XX:MaxRAMPercentage=75.0
#    이점: 컨테이너 메모리의 75%를 힙으로 사용
#    예시: 
#    - 컨테이너 메모리: 1GB
#    - JVM 힙: 750MB (75%)
#    - 나머지 250MB: 메타스페이스, 스레드 스택 등
#    권장: 50-80% (여유 공간 확보)
#
# 3. -Djava.security.egd=file:/dev/./urandom
#    이점: 난수 생성 속도 향상 (SecureRandom 사용 시)
#    예시: JWT 토큰 생성, UUID 생성 시 블로킹 방지
#    성능: /dev/random (느림, 블로킹) → /dev/urandom (빠름, 비블로킹)
#
# 4. -jar app.jar
#    실행할 JAR 파일 지정
#
# 실행 예시:
# $ docker run -m 1g lien-app
# -> JVM 힙 크기: 750MB (1GB * 75%)
#
# 메모리 사용량 확인:
# $ docker stats lien-app
# CONTAINER  MEM USAGE / LIMIT
# lien-app   600MB / 1GB
# ==============================================================================
ENTRYPOINT ["java", \
    "-XX:+UseContainerSupport", \
    "-XX:MaxRAMPercentage=75.0", \
    "-Djava.security.egd=file:/dev/./urandom", \
    "-jar", "app.jar"]

